{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cross-project-components.invalid/protocols/interactive-assets/1.0/fullscreen-animation.schema.json",
  "title": "Fullscreen Animation", "type": "object", "additionalProperties": false,
  "required": ["protocolVersion", "id", "version", "renderer", "media", "loop", "trigger", "contentMode", "dismissible"],
  "properties": {
    "protocolVersion": {"const": "1.0"}, "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
    "renderer": {"enum": ["gif", "lottie", "video", "image-sequence"]},
    "media": {"$ref": "#/$defs/assetReference"}, "durationMs": {"type": "integer", "minimum": 1},
    "loop": {"enum": ["once", "loop", "repeat-count"]}, "trigger": {"type": "string", "minLength": 1},
    "contentMode": {"enum": ["aspectFit", "aspectFill", "scaleToFill"]}, "dismissible": {"type": "boolean"},
    "audio": {"$ref": "#/$defs/assetReference"}, "parameters": {"$ref": "#/$defs/assetReference"}
  },
  "$defs": {"assetReference": {"type": "object", "additionalProperties": false, "required": ["assetID"], "properties": {"assetID": {"type": "string", "minLength": 1}, "role": {"type": "string"}}}}
}
