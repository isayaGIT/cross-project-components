{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cross-project-components.invalid/protocols/interactive-assets/1.0/animated-message-bubble.schema.json",
  "title": "Animated Message Bubble", "type": "object", "additionalProperties": false,
  "required": ["protocolVersion", "id", "version", "renderer", "decorations", "layout"],
  "properties": {
    "protocolVersion": {"const": "1.0"}, "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
    "renderer": {"enum": ["gif", "lottie", "nine-patch-frames"]},
    "background": {"$ref": "#/$defs/assetReference"},
    "decorations": {"type": "array", "items": {"$ref": "#/$defs/decoration"}},
    "layout": {"$ref": "#/$defs/layout"}, "parameters": {"$ref": "#/$defs/assetReference"}
  },
  "$defs": {
    "assetReference": {"type": "object", "additionalProperties": false, "required": ["assetID"], "properties": {"assetID": {"type": "string", "minLength": 1}, "role": {"type": "string"}}},
    "decoration": {"type": "object", "additionalProperties": false, "required": ["id", "asset", "placement", "width", "height", "alignment", "offsetX", "offsetY", "loop"], "properties": {
      "id": {"type": "string", "minLength": 1}, "asset": {"$ref": "#/$defs/assetReference"},
      "placement": {"enum": ["inside", "overlapping"]}, "width": {"type": "number", "exclusiveMinimum": 0},
      "height": {"type": "number", "exclusiveMinimum": 0}, "alignment": {"type": "string", "minLength": 1},
      "offsetX": {"type": "number"}, "offsetY": {"type": "number"}, "loop": {"enum": ["once", "loop", "repeat-count"]},
      "repeatCount": {"type": "integer", "minimum": 1}
    }},
    "layout": {"type": "object", "additionalProperties": false, "required": ["cornerRadius", "paddingTop", "paddingLeading", "paddingBottom", "paddingTrailing"], "properties": {
      "cornerRadius": {"type": "number", "minimum": 0}, "paddingTop": {"type": "number", "minimum": 0},
      "paddingLeading": {"type": "number", "minimum": 0}, "paddingBottom": {"type": "number", "minimum": 0}, "paddingTrailing": {"type": "number", "minimum": 0}
    }}
  }
}
