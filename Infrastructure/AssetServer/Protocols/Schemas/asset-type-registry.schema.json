{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cross-project-components.invalid/protocols/asset-server/1.0/asset-type-registry.schema.json",
  "title": "Asset Server Asset Type Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "assetTypes"],
  "properties": {
    "protocolVersion": {"const": "1.0"},
    "assetTypes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "description", "accepts"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "label": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "accepts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
